app.post("/tipizate/upload", requireAuth, upload.single("pdf"), (req, res) => {
  try {
    if (!req.file) return res.status(400).send("Fișierul PDF este obligatoriu.");

    const title = String(req.body?.title || "").trim();
    const category = String(req.body?.category || "").trim();

    if (!title) return res.status(400).send("Titlul este obligatoriu.");

    const originalName = String(req.file.originalname || "document.pdf");
    const isPdf = originalName.toLowerCase().endsWith(".pdf") || String(req.file.mimetype || "").toLowerCase().includes("pdf");
    if (!isPdf) return res.status(400).send("Se acceptă doar fișiere PDF.");

    const dir = path.join(__dirname, "public", "uploads", "tipizate");
    fs.mkdirSync(dir, { recursive: true });

    const safeBase = originalName
      .replace(/\.pdf$/i, "")
      .replace(/[^a-zA-Z0-9._-]+/g, "-")
      .replace(/-+/g, "-")
      .replace(/^-|-$/g, "") || "document";

    const finalName = `${Date.now()}-${safeBase}.pdf`;
    const destAbs = path.join(dir, finalName);
    fs.renameSync(req.file.path, destAbs);

    const file_path = `uploads/tipizate/${finalName}`;

    db.prepare(`
      INSERT INTO tipizate_docs (title, category, file_name, file_path, mime_type)
      VALUES (?,?,?,?,?)
    `).run(
      title,
      category || null,
      finalName,
      file_path,
      String(req.file.mimetype || "application/pdf")
    );

    return res.redirect("/tipizate");
  } catch (e) {
    return res.status(500).send("Upload failed: " + String(e?.message || e));
  }
});

app.post("/tipizate/:id/delete", requireAuth, (req, res) => {
  try {
    const id = Number(req.params.id);
    if (!Number.isFinite(id)) return res.status(400).send("Bad id");

    const row = db.prepare(`
      SELECT id, file_path
      FROM tipizate_docs
      WHERE id=?
    `).get(id);

    if (!row) return res.status(404).send("Document inexistent");

    const absPath = path.join(__dirname, "public", String(row.file_path || "").replace(/^\/+/, ""));
    if (row.file_path && fs.existsSync(absPath)) {
      try { fs.unlinkSync(absPath); } catch {}
    }

    db.prepare("DELETE FROM tipizate_docs WHERE id=?").run(id);
    return res.redirect("/tipizate");
  } catch (e) {
    return res.status(500).send("Delete failed: " + String(e?.message || e));
  }
});

