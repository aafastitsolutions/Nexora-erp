<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Contracts</title>
  <style>
    body{font-family:Arial,sans-serif;max-width:920px;margin:24px auto;padding:0 12px}
    .row{display:flex;gap:12px;flex-wrap:wrap}
    .card{border:1px solid #ddd;border-radius:10px;padding:14px;margin:12px 0}
    label{display:block;font-size:12px;color:#333;margin:10px 0 4px}
    input,select,textarea{width:100%;padding:10px;border:1px solid #ccc;border-radius:8px}
    textarea{min-height:100px}
    button{padding:10px 14px;border:0;border-radius:10px;cursor:pointer}
    .primary{background:#111;color:#fff}
    .muted{color:#555;font-size:12px}
    .hidden{display:none}
  </style>
</head>
<body>
  <h2>Generator contract PDF</h2>
  <div class="muted">PJ: introdu CUI și apasă “Preia date”. Apoi “Generează PDF”.</div>

  <form class="card" method="post" action="/api/contract/pdf">
    <div class="row">
      <div style="flex:1;min-width:260px">
        <label>Tip client</label>
        <select id="is_company" name="is_company">
          <option value="true">Firmă (PJ)</option>
          <option value="false">Persoană fizică (PF)</option>
        </select>
      </div>
      <div style="flex:1;min-width:260px">
        <label>Email contact</label>
        <input name="contact_email" required />
      </div>
      <div style="flex:1;min-width:260px">
        <label>Telefon (opțional)</label>
        <input name="contact_phone" />
      </div>
    </div>

    <div id="pj" class="card">
      <h3>PJ</h3>
      <div class="row">
        <div style="flex:1;min-width:260px">
          <label>CUI</label>
          <input id="pj_cui" name="pj_cui" placeholder="RO1234567" />
        </div>
        <div style="flex:0;min-width:200px;align-self:end">
          <button type="button" class="primary" id="btnLookup">Preia date</button>
        </div>
      </div>

      <label>Denumire</label>
      <input id="pj_legal_name" name="pj_legal_name" />

      <label>Adresă</label>
      <input id="pj_address" name="pj_address" />

      <label>Nr. RC</label>
      <input id="pj_reg_com" name="pj_reg_com" />

      <div class="row">
        <div style="flex:1;min-width:260px">
          <label>Reprezentant</label>
          <input name="pj_representative_name" required />
        </div>
        <div style="flex:1;min-width:260px">
          <label>Calitate</label>
          <input name="pj_representative_role" value="Administrator" />
        </div>
      </div>
    </div>

    <div id="pf" class="card hidden">
      <h3>PF</h3>
      <label>Nume complet</label>
      <input name="pf_full_name" />

      <label>Adresă</label>
      <input name="pf_address" />
    </div>

    <div class="card">
      <h3>Detalii contract</h3>
      <label>Descriere servicii</label>
      <textarea name="service_description" required>Servicii de dezvoltare și mentenanță software.</textarea>

      <div class="row">
        <div style="flex:1;min-width:180px">
          <label>Preț</label>
          <input name="price_amount" value="1500" />
        </div>
        <div style="flex:1;min-width:180px">
          <label>Monedă</label>
          <select name="price_currency">
            <option>RON</option>
            <option>EUR</option>
          </select>
        </div>
        <div style="flex:2;min-width:260px">
          <label>Termen plată</label>
          <input name="payment_terms" value="15 zile de la emiterea facturii" />
        </div>
      </div>

      <div class="row">
        <div style="flex:1;min-width:220px">
          <label>Data început</label>
          <input name="start_date" type="date" />
        </div>
        <div style="flex:1;min-width:220px">
          <label>Durată</label>
          <input name="duration" value="12 luni" />
        </div>
        <div style="flex:1;min-width:220px">
          <label>Preaviz încetare (zile)</label>
          <input name="termination_notice_days" value="30" />
        </div>
      </div>

      <div style="margin-top:12px">
        <button class="primary" type="submit">Generează PDF</button>
      </div>
    </div>
  </form>

  <script>
    const isCompany = document.getElementById("is_company");
    const pj = document.getElementById("pj");
    const pf = document.getElementById("pf");
    const btn = document.getElementById("btnLookup");

    function toggle() {
      const v = isCompany.value === "true";
      pj.classList.toggle("hidden", !v);
      pf.classList.toggle("hidden", v);
    }
    isCompany.addEventListener("change", toggle);
    toggle();

    btn.addEventListener("click", async () => {
      const cui = document.getElementById("pj_cui").value;
      if (!cui) return alert("Introdu CUI");
      btn.disabled = true;
      btn.textContent = "Se caută…";
      try {
        const r = await fetch("/api/company?cui=" + encodeURIComponent(cui));
        const j = await r.json();
        if (!r.ok) throw new Error(j.error || "Lookup failed");
        document.getElementById("pj_legal_name").value = j.legal_name || "";
        document.getElementById("pj_address").value = j.address || "";
        document.getElementById("pj_reg_com").value = j.reg_com || "";
      } catch (e) {
        alert("Eroare: " + e.message);
      } finally {
        btn.disabled = false;
        btn.textContent = "Preia date";
      }
    });
  </script>
</body>
</html>
