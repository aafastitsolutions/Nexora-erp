app.post("/login", (req, res) => {
  const email = String(req.body?.email || "").trim().toLowerCase();
  const password = String(req.body?.password || "");
  const u = verifyUser(email, password);
  if (!u) return res.status(401).type("html").send("<p style='font-family:system-ui'>Login invalid. <a href='/login'>Înapoi</a></p>");
  req.session.user = { id: u.id, email: u.email, role: u.role };
  return res.redirect("/dashboard");
});

app.post("/logout", (req, res) => {
  req.session?.destroy(() => res.redirect("/login"));
});

app.get("/dashboard", requireAuth, (req, res) => {
  const rows = db.prepare(`
    SELECT c.id, c.contract_number, c.created_at, c.price, c.duration,
           cl.name AS client_name, cl.cui AS client_cui,
           c.pdf_path
    FROM contracts c
    JOIN clients cl ON cl.id = c.client_id
    ORDER BY c.id DESC
    LIMIT 200
  `).all();

  const userEmail = req.session.user.email;
  const htmlRows = rows.map(r => `
    <tr>
      <td>${escapeHtml(r.contract_number)}</td>
      <td>${escapeHtml(r.client_name)}<br><small>${escapeHtml(r.client_cui || "")}</small></td>
      <td>${escapeHtml(String(r.price ?? ""))}</td>
      <td>${escapeHtml(r.duration || "")}</td>
      <td>${escapeHtml(r.created_at || "")}</td>
      <td>${r.pdf_path ? `<a href="/${encodeURI(r.pdf_path)}" target="_blank">PDF</a>` : ""}</td>
    </tr>`).join("");

  res.type("html").send(`
