app.post("/client/:id/contacts/add", requireAuth, (req, res) => {
  const client_id = Number(req.params.id);
  if (!Number.isFinite(client_id)) return res.status(400).send("Bad id");

  const name = String(req.body?.name || "").trim();
  const email = String(req.body?.email || "").trim();
  const phone = String(req.body?.phone || "").trim();
  const position = String(req.body?.position || "").trim();
  const is_primary = req.body?.is_primary ? 1 : 0;

  if (!name) return res.status(400).send("name required");

  const tx = db.transaction(() => {
    if (is_primary) db.prepare("UPDATE contacts SET is_primary=0 WHERE client_id=?").run(client_id);
    db.prepare(`
      INSERT INTO contacts (client_id, name, email, phone, position, is_primary)
      VALUES (?,?,?,?,?,?)
    `).run(client_id, name, email || null, phone || null, position || null, is_primary);
  });

  tx();
  return res.redirect("/client/" + client_id);
});

