const COMPANY = {
  name: "QR-LAB SRL",
  cui: "47446760",
  rc: "J29/XXXX/2023",
  address: "Prahova, Bucov, Chitorani",
  iban: "ROXXBANKXXXXXXXXXXXX",
  bank: "Banca Transilvania",
  representative: "Pita Valentin"
};

import express from "express";
import session from "express-session";
import Mustache from "mustache";
import fs from "fs";
import path from "path";
import { fileURLToPath } from "url";
import { renderPdfBuffer } from "./pdf.js";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
app.use(express.json({ limit: "2mb" }));
app.use(express.urlencoded({ extended: true }));

const templateHtml = fs.readFileSync(path.join(__dirname, "template.html"), "utf8");
const uiHtml = fs.readFileSync(path.join(__dirname, "ui.html"), "utf8");

function normalizeCui(input = "") {
  return String(input).toUpperCase().replace(/^RO/, "").replace(/\D/g, "");
}

function todayISO() {
  return new Date().toISOString().slice(0, 10);
}

// ANAF TVA webservice v7: https://webservicesp.anaf.ro/PlatitorTvaRest/api/v6/ws/tva
app.get("/api/company", async (req, res) => {
  try {
    const cui = normalizeCui(req.query.cui);
    if (!cui) return res.status(400).json({ error: "CUI invalid" });

    const payload = [{ cui: Number(cui), data: todayISO() }];

    const endpoints = [
      "https://webservicesp.anaf.ro/api/PlatitorTvaRest/v9/tva",
      "https://webservicesp.anaf.ro/api/PlatitorTvaRest/v8/tva",
      "https://webservicesp.anaf.ro/api/PlatitorTvaRest/v7/tva",
      "https://webservicesp.anaf.ro/api/PlatitorTvaRest/v6/tva"
    ];

    let lastErr = null;

    for (const url of endpoints) {
      const r = await fetch(url, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
          // uneori ajută la WAF/redirect-uri care returnează HTML
          "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) contracts-app/1.0"
        },
        body: JSON.stringify(payload),
        redirect: "follow",
      });

      const ct = (r.headers.get("content-type") || "").toLowerCase();
      const txt = await r.text();

      // dacă ANAF ne dă HTML (mentenanță / redirect / 404), încercăm următorul endpoint
      if (!ct.includes("application/json")) {
        lastErr = { url, status: r.status, details: txt.slice(0, 300) };
        continue;
      }

      if (!r.ok) {
        lastErr = { url, status: r.status, details: txt.slice(0, 300) };
        continue;
      }

      const data = JSON.parse(txt);
      const found = data?.found?.[0];
      if (!found?.date_generale) {
        return res.status(404).json({ error: "CUI negăsit în răspunsul ANAF", source_url: url });
      }

      const dg = found.date_generale;
      return res.json({
        normalized_cui: String(dg.cui ?? cui),
        legal_name: dg.denumire ?? "",
        address: dg.adresa ?? "",
        reg_com: dg.nrRegCom ?? "",
        caen: dg.cod_CAEN ?? "",
        vat: found?.inregistrare_scop_Tva?.scpTVA ?? null,
        inactive: found?.stare_inactiv?.statusInactivi ?? null,
        source_url: url,
        fetched_at: new Date().toISOString()
      });
    }

    return res.status(502).json({
      error: "ANAF unavailable / returned non-JSON",
      tried: endpoints,
      last: lastErr
    });

  } catch (e) {
    return res.status(500).json({ error: "Server error", details: String(e?.message ?? e) });
  }
});

app.get("/", (req, res) => res.type("html").send(uiHtml));

app.post("/api/contract/pdf", async (req, res) => {
  try {
    const body = req.body || {};

    const provider = {
      provider_legal_name: "QR-LAB SRL",
      provider_address: "Completează adresa prestatorului",
      provider_cui: "ROXXXXXXX",
      provider_reg_com: "Jxx/xxxx/xxxx",
      provider_iban: "ROxxBANKxxxxxxxxxxxxxx",
      provider_bank: "Banca",
      provider_representative_name: "Nume Reprezentant",
      provider_representative_role: "Administrator",
    };

    const is_company = body.is_company === "true" || body.is_company === true;

    const vm = {
      ...provider,
      contract_number: body.contract_number || `CTR-${Date.now()}`,
      contract_date: body.contract_date || todayISO(),
      is_company,

      contact_email: body.contact_email || "",
      contact_phone: body.contact_phone || "",

      pj_cui: body.pj_cui || "",
      pj_legal_name: body.pj_legal_name || "",
      pj_address: body.pj_address || "",
      pj_reg_com: body.pj_reg_com || "",
      pj_representative_name: body.pj_representative_name || "",
      pj_representative_role: body.pj_representative_role || "Administrator",

      pf_full_name: body.pf_full_name || "",
      pf_address: body.pf_address || "",

      service_description: body.service_description || "",
      price_amount: body.price_amount || "",
      price_currency: body.price_currency || "RON",
      payment_terms: body.payment_terms || "15 zile",
      start_date: body.start_date || todayISO(),
      duration: body.duration || "12 luni",
      termination_notice_days: body.termination_notice_days || "30",
      jurisdiction_city: body.jurisdiction_city || "București",
      privacy_policy_url: body.privacy_policy_url || "https://qr-lab.ro",

      client_signer_name: is_company ? (body.pj_representative_name || "") : (body.pf_full_name || ""),
      provider_signer_name: provider.provider_representative_name,
    };

    const html = Mustache.render(templateHtml, { ...vm, company: COMPANY });
    const pdf = await renderPdfBuffer(html);

    res.setHeader("Content-Type", "application/pdf");
    res.setHeader("Content-Disposition", `attachment; filename="contract-${vm.contract_number}.pdf"`);
    res.send(pdf);
  } catch (e) {
    res.status(500).json({ error: "PDF error", details: String(e?.message ?? e) });
  }
});

app.listen(3000, "0.0.0.0", () => console.log("Contracts app running on :3000"));
