  db.prepare("DELETE FROM facturi_linii WHERE id=? AND factura_id=?").run(lid, factura_id);
  recalcFacturaTotals(factura_id);
  return res.redirect("/factura/" + factura_id);
});

app.post("/factura/:id/status", requireAuth, (req,res)=>{
