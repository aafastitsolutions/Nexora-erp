app.post("/facturi", requireAuth, async (req,res)=>{

  const cui = normalizeCui(req.body.cui || "");
  const scadenta = req.body.scadenta || null;

  // checkbox: daca lipseste, inseamna unchecked
  const aplica_tva = String(req.body?.aplica_tva || "") === "1";

  if(!cui) return res.status(400).send("CUI required");

  // refresh / upsert client din ANAF (mereu, ca sa se actualizeze)
  let anaf = null;
  try {
    anaf = await fetchAnafCompany(cui);
  } catch(e){
    // daca ANAF pica, continuam cu ce avem in DB (dar NU blocam)
    console.warn("ANAF client refresh failed:", String(e?.message ?? e));
  }

  let client = db.prepare("SELECT id, vat FROM clients WHERE cui=?").get(cui);

  if(!client){
    if(anaf){
      db.prepare(`
        INSERT INTO clients (cui,name,address,reg_com,caen,vat,inactive)
        VALUES (?,?,?,?,?,?,?)
      `).run(anaf.cui, anaf.name || ("Client "+cui), anaf.address||null, anaf.reg_com||null, anaf.caen||null, anaf.vat||0, anaf.inactive||0);
    } else {
      db.prepare("INSERT INTO clients (cui,name,vat,inactive) VALUES (?,?,0,0)").run(cui,"Client "+cui);
    }
    client = db.prepare("SELECT id, vat FROM clients WHERE cui=?").get(cui);
  } else {
    // update cu datele ANAF daca avem raspuns
    if(anaf){
      db.prepare(`
        UPDATE clients
        SET name=?, address=?, reg_com=?, caen=?, vat=?, inactive=?
        WHERE cui=?
      `).run(anaf.name || ("Client "+cui), anaf.address||null, anaf.reg_com||null, anaf.caen||null, anaf.vat||0, anaf.inactive||0, cui);

      client = db.prepare("SELECT id, vat FROM clients WHERE cui=?").get(cui);
    }
  }

  const client_id = client.id;

  if(!client_id) return res.status(400).send("Client negasit/creat");

  // TVA controlat direct din checkbox:
  // bifat => aplicam cota default
  // debifat => TVA 0
  const defaultRate = Number(process.env.VAT_RATE_DEFAULT || "0.19");
  let tva_procent = aplica_tva ? defaultRate : 0;

  const n = nextFacturaNumber();

  const r = db.prepare(`
    INSERT INTO facturi
    (factura_nr, an, seq, client_id, scadenta, tva_procent)
    VALUES (?,?,?,?,?,?)
  `).run(
    n.factura_nr,
    n.an,
    n.seq,
    client_id,
    scadenta,
    tva_procent
  );

  res.redirect("/factura/"+r.lastInsertRowid);

});



